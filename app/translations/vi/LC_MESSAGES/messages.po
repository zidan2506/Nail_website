#: app/services/email_system.py:81
msgid "Verify your email – Daha Care"
msgstr "Xác minh email của bạn – Daha Care"

#: app/services/email_system.py:83
#, python-format
msgid ""
"Hello,\n"
"\n"
"Your verification code is: %(code)s\n"
"\n"
"Please enter this code to confirm your email address and complete your "
"registration.\n"
"\n"
"If you did not create an account with Daha Care, please ignore this "
"email.\n"
msgstr ""
"Xin chào,\n"
"\n"
"Mã xác minh của bạn là: %(code)s\n"
"\n"
"Vui lòng nhập mã này để xác nhận địa chỉ email và hoàn tất đăng ký.\n"
"\n"
"Nếu bạn không tạo tài khoản tại Daha Care, vui lòng bỏ qua email này.\n"

#: app/services/email_system.py:89
msgid "Password Change Request – Daha Care"
msgstr "Yêu cầu đổi mật khẩu – Daha Care"

#: app/services/email_system.py:91
#, python-format
msgid ""
"Hello,\n"
"\n"
"Your verification code is: %(code)s\n"
"\n"
"Please enter this code to confirm your password change request.\n"
"\n"
"If you did not request this, please ignore this email and your password "
"will remain unchanged.\n"
msgstr ""
"Xin chào,\n"
"\n"
"Mã xác minh của bạn là: %(code)s\n"
"\n"
"Vui lòng nhập mã này để xác nhận yêu cầu đổi mật khẩu.\n"
"\n"
"Nếu bạn không thực hiện yêu cầu này, vui lòng bỏ qua email và mật khẩu "
"của bạn sẽ được giữ nguyên.\n"

#: app/services/email_system.py:97
msgid "Email Change Request – Daha Care"
msgstr "Yêu cầu đổi email – Daha Care"

#: app/services/email_system.py:99
#, python-format
msgid ""
"Hello,\n"
"\n"
"Your verification code is: %(code)s\n"
"\n"
"Please enter this code to confirm your email address change request.\n"
"\n"
"If you did not request this, please ignore this email and your email "
"address will remain unchanged.\n"
msgstr ""
"Xin chào,\n"
"\n"
"Mã xác minh của bạn là: %(code)s\n"
"\n"
"Vui lòng nhập mã này để xác nhận yêu cầu đổi địa chỉ email.\n"
"\n"
"Nếu bạn không thực hiện yêu cầu này, vui lòng bỏ qua email và địa chỉ "
"email của bạn sẽ được giữ nguyên.\n"

#: app/services/email_system.py:105
msgid "Reset Your Password – Daha Care"
msgstr "Đặt lại mật khẩu – Daha Care"

#: app/services/email_system.py:107
#, python-format
msgid ""
"Hello,\n"
"\n"
"Your password reset code is: %(code)s\n"
"\n"
"Please enter this code to reset your password. This code expires in 10 "
"minutes.\n"
"\n"
"If you did not request a password reset, please ignore this email.\n"
msgstr ""
"Xin chào,\n"
"\n"
"Mã đặt lại mật khẩu của bạn là: %(code)s\n"
"\n"
"Vui lòng nhập mã này để đặt lại mật khẩu. Mã sẽ hết hạn sau 10 phút.\n"
"\n"
"Nếu bạn không yêu cầu đặt lại mật khẩu, vui lòng bỏ qua email này.\n"

#: app/services/email_system.py:113
msgid "Your Booking Verification Code – Daha Care"
msgstr "Mã xác nhận đặt lịch của bạn – Daha Care"

#: app/services/email_system.py:115
#, python-format
msgid ""
"Hello,\n"
"\n"
"Your verification code is: %(code)s\n"
"\n"
"Please enter this code on the verification page to confirm your booking.\n"
"\n"
"If you did not request this, please ignore this email.\n"
msgstr ""
"Xin chào,\n"
"\n"
"Mã xác minh của bạn là: %(code)s\n"
"\n"
"Vui lòng nhập mã này trên trang xác minh để xác nhận đặt lịch.\n"
"\n"
"Nếu bạn không thực hiện yêu cầu này, vui lòng bỏ qua email này.\n"

#: app/services/email_system.py:132
msgid "Your booking request has been received"
msgstr "Chúng tôi đã nhận được yêu cầu đặt lịch của bạn"

#: app/services/email_system.py:134
#, python-format
msgid ""
"Hi %(name)s,\n"
"\n"
"Thank you for your booking.\n"
"\n"
"We have received your booking request and it is currently pending "
"confirmation.\n"
"\n"
"Booking details:\n"
"- Service: %(service)s\n"
"- Staff: %(staff)s\n"
"- Date: %(date)s\n"
"- Time: %(start)s - %(end)s\n"
"\n"
"We will contact you again once your booking has been confirmed.\n"
"\n"
"Best regards,\n"
"Dahacare\n"
msgstr ""
"Xin chào %(name)s,\n"
"\n"
"Cảm ơn bạn đã đặt lịch.\n"
"\n"
"Chúng tôi đã nhận được yêu cầu đặt lịch của bạn và hiện đang chờ xác "
"nhận.\n"
"\n"
"Chi tiết đặt lịch:\n"
"- Dịch vụ: %(service)s\n"
"- Nhân viên: %(staff)s\n"
"- Ngày: %(date)s\n"
"- Giờ: %(start)s - %(end)s\n"
"\n"
"Chúng tôi sẽ liên hệ lại khi đặt lịch của bạn được xác nhận.\n"
"\n"
"Trân trọng,\n"
"Dahacare\n"

