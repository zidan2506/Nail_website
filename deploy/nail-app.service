[Unit]
Description=Nail booking app (gunicorn)
After=network.target

[Service]
Type=notify
User=nailapp
Group=nailapp
WorkingDirectory=/var/www/nail-app
# .env được app tự nạp qua python-dotenv (load_dotenv) khi import config.
ExecStart=/var/www/nail-app/venv/bin/gunicorn -c gunicorn.conf.py run:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
